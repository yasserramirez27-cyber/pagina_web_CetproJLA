# Copia este archivo como ".env" y ajusta los valores.
PORT=3000

# Contraseña inicial del usuario "admin" (solo se usa la primera vez).
# Si la dejas vacía, el servidor genera una y la muestra en la consola.
ADMIN_CLAVE=

# Pon "true" cuando el sitio esté publicado con HTTPS (Render, Railway...).
COOKIE_SEGURA=false
DETRAS_DE_PROXY=false

# Horas que dura una sesión del panel.
HORAS_SESION=8
